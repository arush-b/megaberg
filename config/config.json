{
  "s3": {
    "endpoint": "http://minio:9000",
    "bucket": "lakehouse",
    "region": "us-east-1",
    "access_key": "admin",
    "secret_key": "password",
    "use_default_credentials": false
  },
  "source": {
    "type": "iceberg",
    "catalog": {
      "type": "rest",
      "uri": "http://rest:8181",
      "warehouse": "s3://lakehouse/"
    },
    "namespace": "default",
    "table": "megaberg_1gb"
  },
  "compaction": {
    "target_file_size_mb": 256,
    "min_files_per_partition": 3
  }
}
